# Python bytecode and interpreter caches.
__pycache__/
*.py[cod]
*$py.class

# Python packaging metadata.
*.egg-info/
.eggs/

# Build and distribution output.
build/
dist/

# Virtual environments.
.venv/
venv/
env/

# Test and analysis caches.
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.ruff_cache/
.mypy_cache/

# Local IDE/editor state.
.vscode/
.idea/
*.swp
*.swo
*~

# Operating-system metadata.
.DS_Store
Thumbs.db

# Temporary files.
*.tmp
*.temp

# Sensitive materials.
config.json
pgp/
operators/
